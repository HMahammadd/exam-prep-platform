# Supabase project URL and publishable (anon) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google OAuth / email redirects (Supabase Dashboard → Authentication → URL Configuration)
# Site URL (production): https://www.keplerly.com
# Redirect URLs must include:
#   http://localhost:3000/auth/callback
#   http://localhost:3000/auth/reset-password
#   https://www.keplerly.com/auth/callback
#   https://www.keplerly.com/auth/reset-password
#   https://keplerly.com/auth/callback
#   https://keplerly.com/auth/reset-password
# Google Cloud authorized redirect URI (provider callback, not the app):
#   https://<PROJECT_REF>.supabase.co/auth/v1/callback

# Service-role key — SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated admin email allowlist (bootstrap access to /admin).
ADMIN_EMAILS=

# Cloudflare Turnstile (signup). Site key is public; secret is server-only.
# Dev test keys (always pass): site 1x00000000000000000000AA
# secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
