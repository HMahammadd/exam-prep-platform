{
  "name": "exam-prep-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "questions:setup:official": "python3 -m pip install --target .question-import/python-deps -r scripts/requirements-import.txt",
    "questions:extract:official": "PYTHONPATH=.question-import/python-deps python3 scripts/extract-official-sat.py",
    "questions:import:official": "node scripts/import-official-sat.mjs",
    "questions:import:official:execute": "node scripts/import-official-sat.mjs --execute",
    "questions:verify:official": "node scripts/verify-official-sat.mjs",
    "questions:extract:keplerly": "PYTHONPATH=.question-import/python-deps python3 scripts/extract-keplerly-exams.py",
    "questions:import:keplerly": "node scripts/import-keplerly-exams.mjs",
    "questions:import:keplerly:execute": "node scripts/import-keplerly-exams.mjs --execute"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.5.3",
    "@sentry/nextjs": "^10.69.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.21.0",
    "next": "16.3.5",
    "posthog-js": "^1.409.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
